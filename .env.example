# Copy this file to `.env` (git-ignored) and fill in your values.
# NEVER commit real tokens. The code runs dry-run (no network) until these are set.

# --- ClickUp ---
CLICKUP_TOKEN=pk_xxxxxxxx        # ClickUp -> avatar -> Settings -> Apps -> API Token (starts pk_)
CLICKUP_LIST_ID=901234567        # the List to push tasks into / pull tasks from (from the list URL)

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...         # Slack app -> OAuth & Permissions -> Bot User OAuth Token (scope: chat:write)
SLACK_CHANNEL=C0XXXXXXX          # channel id (or #name) for notifications; invite the bot to it
SLACK_APP_TOKEN=xapp-...         # Slack app -> App-Level Token (scope: connections:write) — only for the /brain bot

# --- Mail brain (OpenRouter) ---
# Comma-separated list of free-tier OpenRouter API keys. The script rotates to the
# next key on a 401/402/429 (or malformed-response) error from the current one.
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxx
# Free-tier models rotate/deprecate over time — if you see "model not found", check
# https://openrouter.ai/api/v1/models for a currently-valid `:free` id.
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# --- Mail brain (IMAP mailbox to read) ---
# See SETUP.md "Configuring your own mailbox" for how to get an app password.
EMAIL_EMAIL=you@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993              # optional, defaults to 993
